# ACLED credentials.
#
# Register at https://acleddata.com/register/ with an INSTITUTIONAL email
# (your .edu address). A personal gmail account is placed on the Open tier,
# which serves aggregated data only and has no event-level API access, and this
# project cannot work without event-level data.
#
# Copy this file to research/.env and fill it in. .env is gitignored.
# In CI these are repository secrets, not a file.

ACLED_EMAIL=you@njit.edu
ACLED_PASSWORD=
