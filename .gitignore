# secrets
.env
.env.local
.env*.local

# python
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Raw ACLED event cache. Never committed: it is bulk event data, and the ACLED
# EULA is unfriendly to redistributing it. Only the derived aggregates in
# data/generated/ go into the repo.
research/data/raw/
research/data/interim/
# Synthetic fixtures are regenerated by make_fixtures.py; committing 15 MB of
# fake events would be worse than the two seconds it takes to rebuild them.
research/fixtures/*.csv
models/

# node / next
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts

# os
.DS_Store

# Derived artifacts ARE tracked: they are the contract between the Python
# pipeline and the web app, and Vercel builds straight off them.
!public/data/
!public/data/**
